{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "dictionaries": ["martin"],
  "dictionaryDefinitions": [
    {
      "addWords": true,
      "description": "Martin's domain vocabulary",
      "name": "martin",
      "path": ".cspell/project-words.txt"
    }
  ],
  "files": ["README.md", "docs/**/*.md", "*/CHANGELOG.md"],
  "ignoreRegExpList": ["Urls", "HexValues", "Base64", "/@[A-Za-z0-9-]+/g", "/GHSA-[0-9A-Za-z-]+/g"],
  "language": "en,en-GB",
  "version": "0.2"
}
