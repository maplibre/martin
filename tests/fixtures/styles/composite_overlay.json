{
  "font-faces": {
    "Overlay Font": "https://fonts.example/overlay.ttf"
  },
  "glyphs": "/font/{fontstack}/{range}",
  "layers": [
    {
      "id": "overlay-line",
      "source": "alias",
      "source-layer": "roads",
      "type": "line"
    },
    {
      "id": "overlay-points",
      "layout": {
        "text-field": "label",
        "text-font": ["Overlay Font"]
      },
      "paint": {
        "text-opacity": ["global-state", "overlay-opacity"]
      },
      "source": "points",
      "type": "symbol"
    }
  ],
  "metadata": { "from": "overlay" },
  "name": "Composite overlay",
  "sources": {
    "alias": {
      "type": "vector",
      "url": "/shared_source"
    },
    "points": {
      "data": {
        "features": [],
        "type": "FeatureCollection"
      },
      "type": "geojson"
    }
  },
  "sprite": "/sprite/src2",
  "state": {
    "overlay-opacity": { "default": 0.5 }
  },
  "version": 8
}
