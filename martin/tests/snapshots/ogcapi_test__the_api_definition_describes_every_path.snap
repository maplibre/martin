{
  "openapi": "3.0.3",
  "info": {
    "title": "Martin",
    "description": "The tiles Martin serves, as an OGC API",
    "version": "[version]"
  },
  "servers": [
    {
      "url": "http://localhost:8080/ogc"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "operationId": "getLandingPage",
        "summary": "Landing page",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Landing page",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters"
          },
          "404": {
            "description": "No such resource"
          }
        }
      }
    },
    "/api": {
      "get": {
        "operationId": "getApi",
        "summary": "This API definition",
        "parameters": [
          {
            "$ref": "#/components/parameters/apiEncoding"
          }
        ],
        "responses": {
          "200": {
            "description": "This API definition",
            "content": {
              "application/vnd.oai.openapi+json;version=3.0": {
                "schema": {
                  "type": "object"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters"
          },
          "404": {
            "description": "No such resource"
          }
        }
      }
    },
    "/conformance": {
      "get": {
        "operationId": "getConformance",
        "summary": "Conformance classes",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Conformance classes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters"
          },
          "404": {
            "description": "No such resource"
          }
        }
      }
    },
    "/collections": {
      "get": {
        "operationId": "getCollections",
        "summary": "Collections",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Collections",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters"
          },
          "404": {
            "description": "No such resource"
          }
        }
      }
    },
    "/collections/{collectionId}": {
      "get": {
        "operationId": "getCollection",
        "summary": "Collection",
        "parameters": [
          {
            "$ref": "#/components/parameters/collectionId"
          }
        ],
        "responses": {
          "200": {
            "description": "Collection",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters"
          },
          "404": {
            "description": "No such resource"
          }
        }
      }
    },
    "/collections/{collectionId}/tiles": {
      "get": {
        "operationId": "collection.getTileSetsList",
        "summary": "Tilesets of a collection",
        "parameters": [
          {
            "$ref": "#/components/parameters/collectionId"
          }
        ],
        "responses": {
          "200": {
            "description": "Tilesets of a collection",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters"
          },
          "404": {
            "description": "No such resource"
          }
        }
      }
    },
    "/collections/{collectionId}/tiles/{tileMatrixSetId}": {
      "get": {
        "operationId": "collection.getTileSet",
        "summary": "Tileset of a collection",
        "parameters": [
          {
            "$ref": "#/components/parameters/collectionId"
          },
          {
            "$ref": "#/components/parameters/tileMatrixSetId"
          }
        ],
        "responses": {
          "200": {
            "description": "Tileset of a collection",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters"
          },
          "404": {
            "description": "No such resource"
          }
        }
      }
    },
    "/collections/{collectionId}/tiles/{tileMatrixSetId}/{tileMatrix}/{tileRow}/{tileCol}": {
      "get": {
        "operationId": "collection.getTile",
        "summary": "Tile of a collection",
        "parameters": [
          {
            "$ref": "#/components/parameters/collectionId"
          },
          {
            "$ref": "#/components/parameters/tileMatrixSetId"
          },
          {
            "$ref": "#/components/parameters/tileMatrix"
          },
          {
            "$ref": "#/components/parameters/tileRow"
          },
          {
            "$ref": "#/components/parameters/tileCol"
          }
        ],
        "responses": {
          "200": {
            "description": "Tile of a collection",
            "content": {
              "application/vnd.mapbox-vector-tile": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/webp": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/avif": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters"
          },
          "404": {
            "description": "No such resource"
          },
          "204": {
            "description": "Source returned an empty tile"
          },
          "304": {
            "description": "ETag matched If-None-Match"
          },
          "406": {
            "description": "No supported tile format in Accept header"
          }
        }
      }
    },
    "/tileMatrixSets": {
      "get": {
        "operationId": "getTileMatrixSetsList",
        "summary": "Tile matrix sets",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Tile matrix sets",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters"
          },
          "404": {
            "description": "No such resource"
          }
        }
      }
    },
    "/tileMatrixSets/{tileMatrixSetId}": {
      "get": {
        "operationId": "getTileMatrixSet",
        "summary": "Tile matrix set definition",
        "parameters": [
          {
            "$ref": "#/components/parameters/tileMatrixSetId"
          }
        ],
        "responses": {
          "200": {
            "description": "Tile matrix set definition",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters"
          },
          "404": {
            "description": "No such resource"
          }
        }
      }
    },
    "/styles": {
      "get": {
        "operationId": "getStyles",
        "summary": "Styles",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Styles",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters"
          },
          "404": {
            "description": "No such resource"
          }
        }
      }
    },
    "/styles/{styleId}": {
      "get": {
        "operationId": "getStyle",
        "summary": "MapLibre style",
        "parameters": [
          {
            "$ref": "#/components/parameters/styleId"
          },
          {
            "$ref": "#/components/parameters/styleEncoding"
          }
        ],
        "responses": {
          "200": {
            "description": "MapLibre style",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters"
          },
          "404": {
            "description": "No such resource"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "collectionId": {
        "name": "collectionId",
        "in": "path",
        "required": true,
        "description": "ID of a collection, the ID of a source",
        "schema": {
          "type": "string"
        }
      },
      "tileMatrixSetId": {
        "name": "tileMatrixSetId",
        "in": "path",
        "required": true,
        "description": "ID of a tile matrix set",
        "schema": {
          "type": "string"
        }
      },
      "tileMatrix": {
        "name": "tileMatrix",
        "in": "path",
        "required": true,
        "description": "Zoom level of the tile",
        "schema": {
          "type": "string"
        }
      },
      "tileRow": {
        "name": "tileRow",
        "in": "path",
        "required": true,
        "description": "Row of the tile",
        "schema": {
          "type": "integer",
          "minimum": 0
        }
      },
      "tileCol": {
        "name": "tileCol",
        "in": "path",
        "required": true,
        "description": "Column of the tile",
        "schema": {
          "type": "integer",
          "minimum": 0
        }
      },
      "styleId": {
        "name": "styleId",
        "in": "path",
        "required": true,
        "description": "ID of a style",
        "schema": {
          "type": "string"
        }
      },
      "styleEncoding": {
        "name": "f",
        "in": "query",
        "required": false,
        "description": "Style encoding",
        "schema": {
          "type": "string",
          "enum": [
            "json"
          ]
        }
      },
      "apiEncoding": {
        "name": "f",
        "in": "query",
        "required": false,
        "description": "Encoding of the API definition",
        "schema": {
          "type": "string",
          "enum": [
            "json",
            "html"
          ]
        }
      }
    }
  }
}
