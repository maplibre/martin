exports[`ErrorBoundary > catches errors and renders default fallback UI 1`] = `
<div>
  <script
    nonce=""
  >
    ((e,i,s,u,m,a,l,h)=&gt;{let d=document.documentElement,w=["light","dark"];function p(n){(Array.isArray(e)?e:[e]).forEach(y=&gt;{let k=y==="class",S=k&&a?m.map(f=&gt;a[f]||f):m;k?(d.classList.remove(...S),d.classList.add(a&&a[n]?a[n]:n)):d.setAttribute(y,n)}),R(n)}function R(n){h&&w.includes(n)&&(d.style.colorScheme=n)}function c(){return window.matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light"}if(u)p(u);else try{let n=localStorage.getItem(i)||s,y=l&&n==="system"?c():n;p(y)}catch(n){}})("class","theme","light",null,["light","dark"],null,true,true)
  </script>
  <div
    class="rounded-xl border bg-card text-card-foreground shadow-card w-full max-w-md mx-auto mt-8"
  >
    <div
      class="flex flex-col gap-1.5 p-5"
    >
      <div
        class="flex items-center space-x-2"
      >
        <span
          role="img"
        />
        <div
          class="text-base font-semibold leading-snug tracking-tight text-destructive"
        >
          Something went wrong
        </div>
      </div>
      <div
        class="text-sm text-muted-foreground"
      >
        An unexpected error occurred. Please try again or contact support if the problem persists.
      </div>
    </div>
    <div
      class="p-5 pt-0 space-y-4"
    >
      <div
        class="p-3 bg-destructive rounded-md"
      >
        <p
          class="text-sm text-destructive-foreground font-mono"
        >
          Test error thrown!
        </p>
      </div>
      <button
        class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-colors cursor-pointer disabled:cursor-not-allowed disabled:pointer-events-none disabled:bg-muted disabled:text-muted-foreground disabled:shadow-none disabled:ring-1 disabled:ring-inset disabled:ring-border [&_svg]:pointer-events-none [&_svg:not([class*='size-'])]:size-4 shrink-0 [&_svg]:shrink-0 aria-invalid:border-destructive h-11 px-4 py-2 sm:h-9 has-[>svg]:px-3.5 bg-primary text-primary-foreground shadow-xs hover:bg-primary-hover w-full"
        data-slot="button"
      >
        <span
          role="img"
        />
        Try Again
      </button>
    </div>
  </div>
</div>
`;

