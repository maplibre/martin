#!/usr/bin/env just --justfile

set shell := ['bash', '-c']

@_default:
    just --list

# Run BiomeJS formatter and linter
biome:
    npm run format
    npm run lint

# Install node dependencies, unless `package-lock.json` has already been installed.
_npm-install:
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ ! -f node_modules/.package-lock.json || package-lock.json -nt node_modules/.package-lock.json ]]; then
        npm clean-install --no-fund
    fi

# Update frontend test snapshots
bless: _npm-install
    npm run test:update-snapshots

# Build the production bundle `dist/` that the martin-ui crate embeds, unless it is newer than its inputs
build: _npm-install
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ -f dist/index.html && -z "$(find src public index.html package-lock.json vite.config.ts -newer dist/index.html -print -quit)" ]]; then
        echo "dist/ is up to date"
    else
        npm run build
    fi

# Clean build artifacts
clean:
    rm -rf dist node_modules

# Regenerate `src/lib/types.gen.ts` from `martin/openapi.json`.
# Called from the root `gen-schemas` recipe after the spec is written -
# kept in this module so all Node tooling stays behind `mod ui`.
gen-ui-types: _npm-install
    npm run gen-types

# Run frontend tests
test:
    npm run test

# Run TypeScript type checking
type-check:
    npm run type-check
