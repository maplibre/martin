---
source: martin/src/config/file/tiles/postgres/auto_publish.rs
expression: snapshot
input_file: tests/fixtures/pg_auto_publish/from_schemas_combine_outer_and_inner.yaml
---
reads:
  tables:
    schemas:
      - osm
      - public
    only: ~
  functions: true
transforms: []
tables:
  - id: water
    schema: osm
    table: water
    srid: 3857
    geometry_column: geom
  - id: roads
    schema: public
    table: roads
    srid: 3857
    geometry_column: geom
functions:
  - id: tiles
    schema: public
    function: tiles
decisions:
  - ScannedTables:
      schemas:
        - osm
        - public
      id_format: "{table}"
  - ScannedFunctions:
      schemas:
        - public
      id_format: "{function}"
