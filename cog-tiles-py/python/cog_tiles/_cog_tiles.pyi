import os
from collections.abc import Iterator, Mapping, Sequence
from typing import Literal

import numpy as np
import numpy.typing as npt

MAX_ZOOM: int

Bbox = tuple[float, float, float, float]
Crs = Literal["EPSG:4326", "EPSG:3857"]

class CogTilesError(Exception): ...
class UnsupportedCogError(CogTilesError): ...

class TileSource:
    @property
    def min_zoom(self) -> int: ...
    @property
    def max_zoom(self) -> int: ...
    @property
    def tile_size(self) -> int: ...
    @property
    def format(self) -> Literal["jpg", "webp", "png"]: ...
    @property
    def content_type(self) -> str: ...
    @property
    def bounds(self) -> Bbox | None: ...
    @property
    def mercator_bounds(self) -> Bbox | None: ...
    def tile(self, z: int, x: int, y: int) -> bytes | None: ...
    def tile_pixels(self, z: int, x: int, y: int) -> npt.NDArray[np.uint8] | None: ...
    def tiles(
        self,
        bbox: Bbox | None = None,
        zoom: int | Sequence[int] | None = None,
        *,
        crs: Crs = "EPSG:4326",
        concurrency: int = 64,
    ) -> TileIterator: ...
    def read(
        self,
        bbox: Bbox,
        zoom: int | None = None,
        *,
        crs: Crs = "EPSG:4326",
        concurrency: int = 64,
        max_pixels: int = 268_435_456,
    ) -> Raster | None: ...

class Cog(TileSource): ...

class Mosaic(TileSource):
    @property
    def file_zoom(self) -> int: ...
    @property
    def template(self) -> str: ...

class Raster:
    @property
    def data(self) -> npt.NDArray[np.uint8]: ...
    @property
    def transform(self) -> tuple[float, float, float, float, float, float]: ...
    @property
    def bounds(self) -> Bbox: ...
    @property
    def zoom(self) -> int: ...
    @property
    def crs(self) -> Literal["EPSG:3857"]: ...
    def __array__(self, dtype: npt.DTypeLike | None = None, copy: bool | None = None) -> np.ndarray: ...

class TileIterator(Iterator[tuple[int, int, int, bytes]]):
    def __iter__(self) -> TileIterator: ...
    def __next__(self) -> tuple[int, int, int, bytes]: ...

def open(location: str | os.PathLike[str], options: Mapping[str, str] | None = None) -> Cog: ...
def open_mosaic(
    location: str,
    file_zoom: int,
    max_cached_files: int = 1000,
    file_expiry: float = 600.0,
    file_idle_timeout: float | None = None,
    options: Mapping[str, str] | None = None,
) -> Mosaic: ...
