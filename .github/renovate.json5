{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended'],
  // Monday from 05:00 UTC. Renovate has no minute granularity and the Mend app runs
  // roughly hourly, so a one-hour window can be skipped entirely.
  schedule: ['* 5-8 * * 1'],
  minimumReleaseAge: '7 days',
  automerge: true,
  // replaces pre-commit.ci autoupdate for .pre-commit-config.yaml revs
  'pre-commit': { enabled: true },
  prConcurrentLimit: 10,
  prHourlyLimit: 0,
  packageRules: [
    {
      matchManagers: ['github-actions'],
      groupName: 'github-actions',
    },
    {
      matchManagers: ['cargo'],
      groupName: 'cargo dependencies',
    },
    {
      // Breaking bumps get their own PR.
      matchManagers: ['cargo'],
      matchUpdateTypes: ['major'],
      groupName: null,
    },
    {
      matchManagers: ['cargo'],
      matchUpdateTypes: ['minor'],
      matchCurrentVersion: '/^0\\./',
      groupName: null,
    },
    {
      // AWS SDK crates are released in lockstep and must be bumped together.
      matchManagers: ['cargo'],
      matchPackageNames: ['/^aws-/'],
      groupName: 'aws crates',
    },
    {
      // numpy and pyo3-stub-gen each pin one pyo3 minor, which links a single libpython, so they move together.
      matchManagers: ['cargo'],
      matchPackageNames: ['/^pyo3/', 'numpy'],
      groupName: 'pyo3 crates',
    },
    {
      // Maintained by us, so no need to wait for the ecosystem to catch up.
      matchManagers: ['cargo'],
      matchPackageNames: ['maplibre_native', 'mlt-core'],
      minimumReleaseAge: '0 days',
    },
    {
      matchManagers: ['npm'],
      matchPackageNames: ['!@biomejs/biome'],
      groupName: 'npm dependencies',
    },
    {
      // Biome is updated via .pre-commit-config.yaml: renovate bumps the biome
      // hook rev and sync-biome-version propagates it to the biome.json schemas
      // and package.json dependencies.
      matchManagers: ['npm'],
      matchPackageNames: ['@biomejs/biome'],
      enabled: false,
    },
    {
      matchDatasources: ['docker'],
      groupName: 'docker images',
    },
    {
      matchDatasources: ['docker'],
      matchPackageNames: ['ghcr.io/maplibre/martin'],
      minimumReleaseAge: '0 days',
    },
    {
      // Test setup intentionally pins Postgres 15 with PostGIS 3.5 (oldest versions we support).
      // Keep in sync with MINIMUM_POSTGRES_VERSION in martin-core/src/tiles/postgres/pool.rs.
      matchDatasources: ['docker'],
      matchPackageNames: ['postgis/postgis'],
      matchCurrentValue: '/^15-3\\.5/',
      enabled: false,
    },
    {
      // typescript v7 breaks config/OpenAPI/UI-type generation and coverage (#3022);
      // fixing it needs upstream changes we don't have capacity to contribute right now.
      matchManagers: ['npm'],
      matchPackageNames: ['typescript'],
      matchUpdateTypes: ['major'],
      enabled: false,
    },
    {
      // ubuntu:26.04 breaks the docker image build (#3017); fixing it needs upstream
      // changes we don't have capacity to contribute right now.
      matchDatasources: ['docker'],
      matchPackageNames: ['ubuntu'],
      matchUpdateTypes: ['major'],
      enabled: false,
    },
    {
      // The rendering jobs stay on ubuntu-24.04 (#3852): on 26.04 the prebuilt
      // maplibre_native amalgam segfaults in libuv 1.51. Drop this once rendering
      // goes through maplibre-native-ffi (#3849).
      matchDatasources: ['github-runners'],
      matchPackageNames: ['ubuntu'],
      matchCurrentValue: '24.04',
      enabled: false,
    },
    {
      // Pinned to an unreleased Node 24 commit after v2.0.0, which renovate reads as a
      // v2.0.0 prerelease and tries to "update" back to the Node 20 tag.
      matchManagers: ['github-actions'],
      matchPackageNames: ['rustsec/audit-check'],
      allowedVersions: '>2.0.0',
    },
    {
      // static-files 0.3 breaks the Rust build across nearly every target (#2973);
      // fixing it needs upstream changes we don't have capacity to contribute right now.
      matchManagers: ['cargo'],
      matchPackageNames: ['static-files'],
      enabled: false,
    },
  ],
}
