{
  "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
  "extends": "//",
  "files": {
    "includes": [
      "*.{tsx,ts,mjs,json,jsonc,yaml,yml}",
      "{__tests__,__mocks__,e2e,types,app,components,hooks,public,lib,src}/**/*.{tsx,ts,mjs,json,jsonc,yaml,yml}",
      "!node_modules",
      "!dist",
      "!playwright-report",
      "!test-results",
      "!src/lib/types.gen.ts"
    ]
  },
  "linter": {
    "domains": {
      "playwright": "none"
    },
    "rules": {
      "style": {
        "useComponentExportOnlyModules": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["e2e/**"],
      "linter": {
        "domains": {
          "playwright": "recommended"
        }
      }
    }
  ],
  "root": false
}
