#!/usr/bin/env just --justfile

set shell := ['bash', '-c']

# Docker image the end-to-end tests serve the fixtures with
martin_image := env('MARTIN_E2E_IMAGE', 'ghcr.io/maplibre/martin:nightly')
# Repository root, mounted into the martin container
repo_dir := canonicalize(justfile_directory() / '../..')
# Sources the end-to-end tests expect martin to serve, relative to the repository root
e2e_fixtures := 'tests/fixtures/geojson tests/fixtures/pmtiles tests/fixtures/cog/usda_naip_256_lzw_z3.tif --sprite tests/fixtures/sprites/src1 --font tests/fixtures/fonts --style crates/martin-ui/e2e/fixtures/styles'

@_default:
    just --list

# Run BiomeJS formatter and linter
biome:
    npm run format
    npm run lint

# Install node dependencies, unless `package-lock.json` has already been installed.
_npm-install:
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ ! -f node_modules/.package-lock.json || package-lock.json -nt node_modules/.package-lock.json ]]; then
        npm clean-install --no-fund
    fi

# Update frontend test snapshots
bless: _npm-install
    npm run test:update-snapshots

# Build the production bundle `dist/` that the martin-ui crate embeds
build: _npm-install
    npm run build

# Clean build artifacts
clean:
    rm -rf dist node_modules

# Regenerate `src/lib/types.gen.ts` from `crates/martin/openapi.json`.
# Called from the root `gen-schemas` recipe after the spec is written -
# kept in this module so all Node tooling stays behind `mod ui`.
gen-ui-types: _npm-install
    npm run gen-types

# Run the end-to-end tests in Chromium against a prebuilt martin: the nightly Docker image, or `MARTIN_BIN`
e2e *args: _npm-install
    npx playwright install chromium
    npx playwright test {{ args }}

# Serve the end-to-end fixtures on `port` with the martin Docker image
[working-directory('../..')]
e2e-martin port='3010':
    docker rm --force martin-ui-e2e-{{ port }} >/dev/null 2>&1 || true
    exec docker run --rm --init --name martin-ui-e2e-{{ port }} --publish 127.0.0.1:{{ port }}:3000 --volume {{ quote(repo_dir) }}:/work:ro --workdir /work {{ martin_image }} {{ e2e_fixtures }}

# Serve the end-to-end fixtures on `port` with a local martin binary
[working-directory('../..')]
e2e-martin-bin bin port='3010':
    exec {{ quote(bin) }} {{ e2e_fixtures }} --listen-addresses 127.0.0.1:{{ port }}

# Run frontend tests
test:
    npm run test

# Run TypeScript type checking
type-check:
    npm run type-check
