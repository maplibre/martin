{
  "components": {
    "schemas": {
      "Catalog": {
        "properties": {
          "fonts": {
            "additionalProperties": {
              "description": "Font metadata including family, style, glyph count, and Unicode range.",
              "properties": {
                "end": {
                  "description": "Last Unicode codepoint available.",
                  "minimum": 0,
                  "type": "integer"
                },
                "family": {
                  "description": "Font family name (e.g., \"Arial\").",
                  "type": "string"
                },
                "format": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/FontFormat",
                      "description": "Source font file container format."
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "glyphs": {
                  "description": "Total number of glyphs in this font.",
                  "format": "int32",
                  "minimum": 0,
                  "type": "integer"
                },
                "last_modified_at": {
                  "description": "Timestamp of the source font file's last modification.",
                  "format": "date-time",
                  "type": ["string", "null"]
                },
                "start": {
                  "description": "First Unicode codepoint available.",
                  "minimum": 0,
                  "type": "integer"
                },
                "style": {
                  "description": "Font style (e.g., \"Bold\", \"Italic\").\n\nNone for regular style.",
                  "type": ["string", "null"]
                }
              },
              "required": ["family", "glyphs", "start", "end"],
              "type": "object"
            },
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "settings": {
            "description": "Server-wide capability flags",
            "type": "object"
          },
          "sprites": {
            "additionalProperties": {
              "description": "Sprite source metadata.",
              "properties": {
                "images": {
                  "description": "Available sprite image names.",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "last_modified_at": {
                  "description": "Timestamp of the spritesheet's last modification.",
                  "format": "date-time",
                  "type": ["string", "null"]
                },
                "size_in_bytes": {
                  "description": "Total size of the spritesheet in bytes.",
                  "format": "int64",
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "required": ["images"],
              "type": "object"
            },
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "styles": {
            "additionalProperties": {
              "description": "Style metadata.",
              "properties": {
                "colors": {
                  "description": "Distinct colors referenced by the style, for preview swatches.",
                  "items": {
                    "type": "string"
                  },
                  "type": ["array", "null"]
                },
                "last_modified_at": {
                  "description": "Timestamp of the style file's last modification.",
                  "format": "date-time",
                  "type": ["string", "null"]
                },
                "layer_count": {
                  "description": "Number of layers declared in the style JSON.",
                  "format": "int32",
                  "minimum": 0,
                  "type": ["integer", "null"]
                },
                "path": {
                  "description": "Path to the style JSON file.",
                  "type": "string"
                },
                "type": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/StyleKind",
                      "description": "What kind of layers the style draws."
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "version_hash": {
                  "description": "Hash identifying the current style revision.",
                  "type": ["string", "null"]
                }
              },
              "required": ["path"],
              "type": "object"
            },
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "tiles": {
            "additionalProperties": {
              "description": "Metadata for a tile source in the catalog.\n\nContains information needed to properly serve tiles from a source,\nincluding HTTP headers and human-readable metadata.",
              "properties": {
                "attribution": {
                  "description": "Attribution text for the data source",
                  "type": ["string", "null"]
                },
                "content_encoding": {
                  "description": "Optional content encoding (e.g., \"gzip\", \"deflate\")",
                  "type": ["string", "null"]
                },
                "content_type": {
                  "description": "MIME type for the tile data (e.g., \"application/x-protobuf\", \"image/png\")",
                  "type": "string"
                },
                "description": {
                  "description": "Description of the tile source content",
                  "type": ["string", "null"]
                },
                "last_modified_at": {
                  "description": "Timestamp of the underlying source's last modification.",
                  "format": "date-time",
                  "type": ["string", "null"]
                },
                "layer_count": {
                  "description": "Number of vector layers declared by this source.",
                  "format": "int32",
                  "minimum": 0,
                  "type": ["integer", "null"]
                },
                "name": {
                  "description": "Human-readable name for the tile source",
                  "type": ["string", "null"]
                },
                "tile_grid": {
                  "description": "Tile grid the source is served in, when it is not the default Web Mercator grid",
                  "type": ["string", "null"]
                }
              },
              "required": ["content_type"],
              "type": "object"
            },
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          }
        },
        "required": ["tiles", "sprites", "fonts", "styles", "settings"],
        "type": "object"
      },
      "Collection": {
        "description": "A tile source as an OGC API collection.",
        "properties": {
          "description": {
            "type": ["string", "null"]
          },
          "extent": {
            "$ref": "#/components/schemas/Extent"
          },
          "id": {
            "type": "string"
          },
          "links": {
            "items": {
              "$ref": "#/components/schemas/Link"
            },
            "type": "array"
          },
          "title": {
            "type": "string"
          }
        },
        "required": ["id", "title", "extent", "links"],
        "type": "object"
      },
      "Collections": {
        "description": "The collections the OGC API serves.",
        "properties": {
          "collections": {
            "items": {
              "$ref": "#/components/schemas/Collection"
            },
            "type": "array"
          },
          "links": {
            "items": {
              "$ref": "#/components/schemas/Link"
            },
            "type": "array"
          }
        },
        "required": ["collections", "links"],
        "type": "object"
      },
      "Conformance": {
        "description": "The conformance declaration of the OGC API.",
        "properties": {
          "conformsTo": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": ["conformsTo"],
        "type": "object"
      },
      "DataType": {
        "description": "What a source's tiles hold, in the terms of OGC API - Tiles.",
        "enum": ["map", "vector"],
        "type": "string"
      },
      "Extent": {
        "description": "Where a collection's data lies.",
        "properties": {
          "spatial": {
            "$ref": "#/components/schemas/SpatialExtent"
          }
        },
        "required": ["spatial"],
        "type": "object"
      },
      "FontFormat": {
        "description": "Source font file container format.\n\nThe string serialization (serde and `strum`) is the lowercase file\nextension, so [`FontFormat::VARIANTS`] doubles as the list of recognised\nfont extensions and [`str::parse`] maps an extension back to a variant.",
        "enum": ["otf", "ttf", "ttc"],
        "type": "string"
      },
      "LandingPage": {
        "description": "The entry point of the OGC API.",
        "properties": {
          "description": {
            "type": "string"
          },
          "links": {
            "items": {
              "$ref": "#/components/schemas/Link"
            },
            "type": "array"
          },
          "title": {
            "type": "string"
          }
        },
        "required": ["title", "description", "links"],
        "type": "object"
      },
      "Layer": {
        "description": "A layer of a vector tileset.",
        "properties": {
          "dataType": {
            "$ref": "#/components/schemas/DataType"
          },
          "id": {
            "type": "string"
          },
          "maxTileMatrix": {
            "type": ["string", "null"]
          },
          "minTileMatrix": {
            "type": ["string", "null"]
          }
        },
        "required": ["id", "dataType"],
        "type": "object"
      },
      "Link": {
        "description": "A link from one OGC API resource to another.",
        "properties": {
          "href": {
            "type": "string"
          },
          "rel": {
            "type": "string"
          },
          "templated": {
            "description": "Whether `href` is a URI template.",
            "type": "boolean"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": ["href", "rel", "type", "title"],
        "type": "object"
      },
      "SpatialExtent": {
        "description": "The bounding box of a collection, in longitude and latitude.",
        "properties": {
          "bbox": {
            "items": {
              "items": {
                "format": "double",
                "type": "number"
              },
              "type": "array"
            },
            "type": "array"
          },
          "crs": {
            "type": "string"
          }
        },
        "required": ["bbox", "crs"],
        "type": "object"
      },
      "StyleKind": {
        "description": "What kind of layers a `MapLibre` style draws.",
        "enum": ["vector", "raster", "hybrid"],
        "type": "string"
      },
      "TileMatrix": {
        "description": "One zoom level of a tile matrix set.",
        "properties": {
          "cellSize": {
            "format": "double",
            "type": "number"
          },
          "id": {
            "type": "string"
          },
          "matrixHeight": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "matrixWidth": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "pointOfOrigin": {
            "items": {
              "format": "double",
              "type": "number"
            },
            "type": "array"
          },
          "scaleDenominator": {
            "format": "double",
            "type": "number"
          },
          "tileHeight": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "tileWidth": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "scaleDenominator",
          "cellSize",
          "pointOfOrigin",
          "tileWidth",
          "tileHeight",
          "matrixWidth",
          "matrixHeight"
        ],
        "type": "object"
      },
      "TileMatrixLimits": {
        "description": "The tiles of one zoom that hold data.",
        "properties": {
          "maxTileCol": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "maxTileRow": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "minTileCol": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "minTileRow": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "tileMatrix": {
            "type": "string"
          }
        },
        "required": ["tileMatrix", "minTileRow", "maxTileRow", "minTileCol", "maxTileCol"],
        "type": "object"
      },
      "TileMatrixSet": {
        "description": "A tile matrix set in the JSON encoding of OGC Two Dimensional Tile Matrix Set 2.0.",
        "properties": {
          "crs": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "orderedAxes": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "tileMatrices": {
            "items": {
              "$ref": "#/components/schemas/TileMatrix"
            },
            "type": "array"
          },
          "uri": {
            "type": ["string", "null"]
          }
        },
        "required": ["id", "crs", "orderedAxes", "tileMatrices"],
        "type": "object"
      },
      "TileMatrixSetItem": {
        "description": "One tile matrix set in the list, linking to its definition.",
        "properties": {
          "crs": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "links": {
            "items": {
              "$ref": "#/components/schemas/Link"
            },
            "type": "array"
          },
          "uri": {
            "type": ["string", "null"]
          }
        },
        "required": ["id", "crs", "links"],
        "type": "object"
      },
      "TileMatrixSets": {
        "description": "The tile matrix sets the OGC API serves.",
        "properties": {
          "tileMatrixSets": {
            "items": {
              "$ref": "#/components/schemas/TileMatrixSetItem"
            },
            "type": "array"
          }
        },
        "required": ["tileMatrixSets"],
        "type": "object"
      },
      "TileSet": {
        "description": "The metadata of a tileset.",
        "properties": {
          "crs": {
            "type": "string"
          },
          "dataType": {
            "$ref": "#/components/schemas/DataType"
          },
          "layers": {
            "items": {
              "$ref": "#/components/schemas/Layer"
            },
            "type": "array"
          },
          "links": {
            "items": {
              "$ref": "#/components/schemas/Link"
            },
            "type": "array"
          },
          "tileMatrixSetLimits": {
            "items": {
              "$ref": "#/components/schemas/TileMatrixLimits"
            },
            "type": "array"
          },
          "tileMatrixSetURI": {
            "type": ["string", "null"]
          },
          "title": {
            "type": "string"
          }
        },
        "required": ["title", "dataType", "crs", "tileMatrixSetLimits", "links"],
        "type": "object"
      },
      "TileSetItem": {
        "description": "A tileset in a list, linking to its metadata.",
        "properties": {
          "crs": {
            "type": "string"
          },
          "dataType": {
            "$ref": "#/components/schemas/DataType"
          },
          "links": {
            "items": {
              "$ref": "#/components/schemas/Link"
            },
            "type": "array"
          },
          "tileMatrixSetURI": {
            "type": ["string", "null"]
          },
          "title": {
            "type": "string"
          }
        },
        "required": ["title", "dataType", "crs", "links"],
        "type": "object"
      },
      "TileSets": {
        "description": "The tilesets of a collection.",
        "properties": {
          "links": {
            "items": {
              "$ref": "#/components/schemas/Link"
            },
            "type": "array"
          },
          "tilesets": {
            "items": {
              "$ref": "#/components/schemas/TileSetItem"
            },
            "type": "array"
          }
        },
        "required": ["tilesets", "links"],
        "type": "object"
      }
    }
  },
  "info": {
    "contact": {
      "email": "to.stepan.kuzmin@gmail.com",
      "name": "Stepan Kuzmin"
    },
    "description": "Blazing-fast tile server with PostGIS, MBTiles, and PMTiles support.",
    "license": {
      "name": "MIT OR Apache-2.0"
    },
    "title": "Martin",
    "version": "2.0.0-beta.5"
  },
  "openapi": "3.1.0",
  "paths": {
    "/{source_ids}": {
      "get": {
        "operationId": "get_source_info",
        "parameters": [
          {
            "in": "path",
            "name": "source_ids",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {}
            },
            "description": "TileJSON 3.0.0 metadata for the requested source(s)"
          },
          "404": {
            "description": "No matching source"
          }
        },
        "tags": ["crate::srv"]
      }
    },
    "/{source_ids}/{z}/{x}/{y}": {
      "get": {
        "operationId": "get_tile",
        "parameters": [
          {
            "in": "path",
            "name": "source_ids",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "z",
            "required": true,
            "schema": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "x",
            "required": true,
            "schema": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "y",
            "required": true,
            "schema": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Encoded vector or raster tile"
          },
          "204": {
            "description": "Source(s) returned an empty tile"
          },
          "304": {
            "description": "ETag matched If-None-Match"
          },
          "404": {
            "description": "No matching source"
          },
          "406": {
            "description": "No supported tile format in Accept header"
          }
        },
        "tags": ["crate::srv"]
      }
    },
    "/cache/{source_id}": {
      "delete": {
        "operationId": "purge_source",
        "parameters": [
          {
            "description": "Source ID",
            "in": "path",
            "name": "source_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "The source's cached tiles are gone, or tile cacheing is disabled."
          },
          "404": {
            "description": "No such source"
          }
        },
        "tags": ["crate::srv"]
      }
    },
    "/catalog": {
      "get": {
        "operationId": "get_catalog",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Catalog"
                }
              }
            },
            "description": "Catalog of all configured sources"
          }
        },
        "tags": ["crate::srv"]
      }
    },
    "/font/{fontstack}/{start}-{end}": {
      "get": {
        "operationId": "get_font",
        "parameters": [
          {
            "in": "path",
            "name": "fontstack",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "start",
            "required": true,
            "schema": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "end",
            "required": true,
            "schema": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/x-protobuf": {}
            },
            "description": "Glyph PBF range"
          },
          "400": {
            "description": "Invalid glyph range"
          },
          "404": {
            "description": "No matching font"
          }
        },
        "tags": ["crate::srv"]
      }
    },
    "/health": {
      "get": {
        "operationId": "get_health",
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Service healthy"
          }
        },
        "summary": "Return 200 OK if healthy. Used for readiness and liveness probes.",
        "tags": ["crate::srv"]
      }
    },
    "/ogc": {
      "get": {
        "operationId": "get_landing_page",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LandingPage"
                }
              }
            },
            "description": "OGC API landing page"
          }
        },
        "summary": "The OGC API landing page, at `/ogc` and `/ogc/`.",
        "tags": ["crate::srv::ogcapi"]
      }
    },
    "/ogc/collections": {
      "get": {
        "operationId": "get_collections",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Collections"
                }
              }
            },
            "description": "Every tile source on a tile matrix set with an OGC definition"
          }
        },
        "summary": "Every tile source on a tile matrix set with an OGC definition, as a collection.",
        "tags": ["crate::srv::ogcapi"]
      }
    },
    "/ogc/collections/{collection_id}": {
      "get": {
        "operationId": "get_collection",
        "parameters": [
          {
            "description": "Collection ID, the ID of a source",
            "in": "path",
            "name": "collection_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Collection"
                }
              }
            },
            "description": "Collection"
          },
          "404": {
            "description": "No such collection"
          }
        },
        "summary": "One collection.",
        "tags": ["crate::srv::ogcapi"]
      }
    },
    "/ogc/collections/{collection_id}/tiles": {
      "get": {
        "operationId": "get_tilesets",
        "parameters": [
          {
            "description": "Collection ID, the ID of a source",
            "in": "path",
            "name": "collection_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TileSets"
                }
              }
            },
            "description": "Tilesets of the collection"
          },
          "404": {
            "description": "No such collection"
          }
        },
        "summary": "The tilesets of one collection, one per tile matrix set it is served on.",
        "tags": ["crate::srv::ogcapi"]
      }
    },
    "/ogc/collections/{collection_id}/tiles/{tile_matrix_set_id}": {
      "get": {
        "operationId": "get_tileset",
        "parameters": [
          {
            "in": "path",
            "name": "collection_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "tile_matrix_set_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TileSet"
                }
              }
            },
            "description": "Tileset metadata with the tile URL template"
          },
          "404": {
            "description": "No such collection or tileset"
          }
        },
        "summary": "The metadata of one tileset, with the template of its tile URLs.",
        "tags": ["crate::srv::ogcapi"]
      }
    },
    "/ogc/collections/{collection_id}/tiles/{tile_matrix_set_id}/{tile_matrix}/{tile_row}/{tile_col}": {
      "get": {
        "operationId": "get_ogc_tile",
        "parameters": [
          {
            "in": "path",
            "name": "collection_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
